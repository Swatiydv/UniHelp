<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="UniHelp connects university students to ask questions, share resources, request help, and borrow or lend items.">
    <title>UniHelp | Students Helping Students</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="landing-page">

    <!-- NAVBAR -->
    <nav class="landing-navbar">
        <a class="brand landing-brand" href="/">
            <span class="logo-mark"><span>U</span></span>
            <span>Uni<span>Help</span></span>
        </a>

        <div class="landing-nav-links">
            <a href="/">Home</a>
            <a href="#about">About</a>
            <a href="#features">Features</a>
            <a href="/login">Login</a>
            <a href="/signup" class="join-btn">Join UniHelp →</a>
        </div>
    </nav>


    <!-- HERO SECTION -->
    <header class="landing-hero">
        <div class="hero-content">
            <span class="landing-tag">
                🎓 Built for university students
            </span>

            <h1>
                Your campus.<br>
                Your community.<br>
                <span>Your UniHelp.</span>
            </h1>

            <p>
                From finding study resources to borrowing essentials,
                UniHelp brings students together to share, support,
                and grow as one campus community.
            </p>
            <div class="hero-actions">
                <a href="/signup" class="primary-btn">
                    Get Started — It's Free →
                </a>

                <a href="#features" class="landing-secondary-btn">
                    Explore Features
                </a>
            </div>

            <div class="hero-trust">
                <span class="trust-icon">🤝</span>
                <span>Built on collaboration. Powered by students.</span>
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-orb hero-orb-one"></div>
            <div class="hero-orb hero-orb-two"></div>

            <div class="hero-dashboard">
                <div class="dashboard-top">
                    <div class="dashboard-brand">
                        <span class="dashboard-logo">U</span>
                        <span>UniHelp <small>Campus community</small></span>
                    </div>
                    <span class="dashboard-status">● Live</span>
                </div>

                <div class="dashboard-welcome">
                    <span>YOUR CAMPUS FEED</span>
                    <h3>Good things happen when we help.</h3>
                    <p>See what's happening in your community.</p>
                </div>

                <div class="dashboard-post">
                    <div class="post-avatar avatar-purple">S</div>
                    <div class="post-content">
                        <div class="post-heading">
                            <strong>Study Resources</strong>
                            <span>Just now</span>
                        </div>
                        <p>Sharing my DBMS revision notes for everyone! 📚</p>
                        <span class="post-tag">📖 Resource shared</span>
                    </div>
                </div>

                <div class="dashboard-post">
                    <div class="post-avatar avatar-orange">A</div>
                    <div class="post-content">
                        <div class="post-heading">
                            <strong>Need a helping hand</strong>
                            <span>2 min ago</span>
                        </div>
                        <p>Can someone help me understand this assignment? 💡</p>
                        <span class="post-tag post-tag-orange">🤝 Help request</span>
                    </div>
                </div>

                <div class="dashboard-bottom">
                    <span>💜 Small acts, stronger communities.</span>
                    <span class="dashboard-heart">♥</span>
                </div>
            </div>

            <div class="floating-card floating-card-top">
                <span class="floating-icon">📚</span>
                <span><strong>Knowledge shared</strong><small>Everyone grows</small></span>
            </div>

            <div class="floating-card floating-card-bottom">
                <span class="floating-icon floating-icon-green">✓</span>
                <span><strong>Help is on the way!</strong><small>Community in action</small></span>
            </div>
        </div>
    </header>



    <!-- ABOUT SECTION -->
    <section class="landing-section" id="about">
        <div class="landing-section-heading">
            <h2>What is UniHelp?</h2>
            <p>A community where students support students.</p>
        </div>

        <div class="landing-about">
            <p>
                UniHelp is a university community platform designed to make
                student life easier, more collaborative, and more connected.
                It gives students a space to ask questions, request help,
                share resources, and borrow or lend useful items.
            </p>

            <p>
                Because sometimes, the best solution isn't searching
                everywhere. It's simply asking someone in your own community.
            </p>
        </div>
    </section>


    <!-- FEATURES SECTION -->
    <section class="landing-section landing-mission" id="features">
        <div class="landing-section-heading">
            <h2>Everything Students Need, in One Place</h2>
            <p>
                From solving everyday problems to sharing resources,
                UniHelp makes student collaboration easier.
            </p>
        </div>

        <div class="landing-grid">

            <div class="landing-card">
                <div class="landing-icon">🙋</div>
                <h3>Ask for Help</h3>
                <p>
                    Post a help request when you need assistance with
                    academics, campus life, or everyday student problems.
                </p>
            </div>

            <div class="landing-card">
                <div class="landing-icon">💬</div>
                <h3>Ask Questions</h3>
                <p>
                    Connect with fellow students, exchange knowledge,
                    and learn from each other's experiences.
                </p>
            </div>

            <div class="landing-card">
                <div class="landing-icon">📚</div>
                <h3>Share Resources</h3>
                <p>
                    Share useful study materials, information, and resources
                    that can make another student's journey easier.
                </p>
            </div>

            <div class="landing-card">
                <div class="landing-icon">🤝</div>
                <h3>Borrow & Lend</h3>
                <p>
                    Borrow items you need or lend things that could
                    help another student in your community.
                </p>
            </div>

            <div class="landing-card">
                <div class="landing-icon">🛍️</div>
                <h3>Buy & Sell</h3>
                <p>
                    Find useful items or sell things you no longer need
                    within your student community.
                </p>
            </div>

            <div class="landing-card">
                <div class="landing-icon">⭐</div>
                <h3>Build Trust</h3>
                <p>
                    Help others, participate responsibly, and build trust
                    through positive community interactions.
                </p>
            </div>

        </div>
    </section>


    <!-- MISSION AND VISION -->
    <section class="landing-section">
        <div class="landing-section-heading">
            <h2>Our Mission & Vision</h2>
            <p>
                Creating a campus culture where asking for help
                and helping others feels natural.
            </p>
        </div>

        <div class="landing-mission-grid">

            <div class="landing-card">
                <div class="landing-icon">🎯</div>
                <h3>Our Mission</h3>
                <p>
                    To make university life easier by creating a supportive
                    environment where students can exchange knowledge,
                    share resources, and help one another.
                </p>
            </div>

            <div class="landing-card">
                <div class="landing-icon">🌱</div>
                <h3>Our Vision</h3>
                <p>
                    To build a connected student community where
                    collaboration, kindness, and shared resources
                    become a natural part of campus life.
                </p>
            </div>

        </div>
    </section>


    <!-- CALL TO ACTION -->
    <section class="landing-cta">
        <h2>Be Part of Something Helpful.</h2>

        <p>
            University life is easier when we support each other.
            Join UniHelp and become part of a community that cares.
        </p>

        <a href="/signup" class="primary-btn">
            Join the Community →
        </a>
    </section>


    <!-- FOOTER -->
    <footer class="landing-footer">
        <p>
            © <%= new Date().getFullYear() %> UniHelp.
                Made for students, powered by community. ❤️
        </p>
    </footer>

</body>

</html>