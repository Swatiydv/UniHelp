<!doctype html><html><head><title>Admin Control • UniHelp</title><%- include('partials/head') %></head><body><%- include('partials/nav') %><main class="shell"><div class="admin-hero"><div><p class="eyebrow">CONTROL CENTER</p><h1>UniHelp Admin</h1><p class="muted">Moderate users and community content.</p></div><div class="admin-stat"><b><%=users.length%></b><span>Users</span></div><div class="admin-stat"><b><%=posts.length%></b><span>Posts</span></div></div><div class="admin-grid"><section class="admin-card"><h2>Users</h2><%users.forEach(u=>{%><div class="admin-row"><div><b><%=u.name%></b><small><%=u.email%> · <%=u.role%></small></div><form method="post" action="/admin/users/<%=u._id%>/toggle"><button><%=u.role==='admin'?'Make student':'Make admin'%></button></form></div><%})%></section><section class="admin-card"><h2>Posts</h2><%posts.forEach(p=>{%><div class="admin-row"><div><b><%=p.type%></b><small><%=p.user?.name||'Unknown'%> · <%=p.content.slice(0,70)%></small></div><form method="post" action="/admin/posts/<%=p._id%>/delete"><button class="danger">Delete</button></form></div><%})%></section></div></main></body></html>
