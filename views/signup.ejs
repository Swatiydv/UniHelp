<!doctype html><html><head><title>Join UniHelp</title><%- include('partials/head') %></head><body class="auth-page"><div class="auth-card wide"><a class="brand big" href="/"><span class="logo-mark"><span>U</span></span><span>Uni<span>Help</span></span></a><h1>Join your campus</h1><p class="muted">Create your student community account.</p><% if(error){%><div class="alert"><%=error%></div><%}%><form method="post" action="/signup" id="signupForm"><div class="grid2"><label>Full name<input name="name" value="<%=form?.name||''%>" required minlength="2"></label><label>Email<input type="email" name="email" value="<%=form?.email||''%>" required></label><label>Department<input name="department" value="<%=form?.department||''%>"></label><label>Year<input name="year" value="<%=form?.year||''%>" placeholder="e.g. 2nd Year"></label></div><label>Password<input id="pw" type="password" name="password" required><small id="pwHelp">8+ chars · uppercase · lowercase · number · special character</small></label><button class="primary">Create account</button></form><p class="switch">Already a member? <a href="/login">Login</a></p></div><script src="/js/auth.js"></script></body></html>
